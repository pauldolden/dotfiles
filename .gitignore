# macOS
.DS_Store

# Credentials and machine-local identity — never commit
1Password/
gcloud/
github-copilot/
gh/hosts.yml
zsh/secrets.zsh

# Per-machine settings. Seeded from the matching .example files by bootstrap.sh.
git/config.local
bootstrap.local
theme/palette.local.toml
zsh/aliases.local.zsh
zsh/functions.local.zsh
zsh/completions.local.zsh
# Claude Code writes autoMode back into this file — a generated threat
# model of whatever this machine works on. Never tracked.
ai/claude/settings.json
ai/AGENTS.local.md
ai/mcp-servers.local.json
Brewfile.local
mise/conf.d/local.toml

# Machine-local tool state
.semgrep/
# brew trust store — lands here because XDG_CONFIG_HOME is this repo
homebrew/
configstore/
containers/
opencode/
raycast/
simple-update-notifier/
uv/
wireshark/
zed/
menus/
tanstack/
memos.json
.nvmrc

# Superseded / unused tooling
fish/
gatsby/
grammarly-languageserver/
gtk-2.0/
gtk-3.0/
helix/
yarn/
Battle.net/
lightspeed-nvim/

# Upstream clone — .zshrc bootstraps this on a fresh machine
zsh/fzf-tab/

# Editor backups and stray temp files
*.bak
*.bak/
*.toml-[0-9]*
*.log

# 1Password CLI device state
op/

# tmux plugins — upstream clones, bootstrapped by tmux.conf
tmux/plugins/
