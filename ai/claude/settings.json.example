{
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/ai/claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "atlassian@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "postman@claude-plugins-official": false,
    "data-engineering@claude-plugins-official": true,
    "data@claude-plugins-official": true,
    "terraform@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "stripe@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": false,
    "sonarqube@claude-plugins-official": false,
    "miro@claude-plugins-official": false,
    "auth0@claude-plugins-official": false,
    "caveman@caveman": true,
    "svelte@svelte": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "theme": "dark-ansi"
}
