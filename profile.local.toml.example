# Machine-local module overrides. Untracked — seeded from this file by
# bootstrap.sh. Merged over profile.toml, so a name here wins.
#
# The two input-stack modules are off in profile.toml because they change how
# the whole machine behaves — AeroSpace tiles every window, Hammerspoon remaps
# scroll and mouse buttons — and both need an Accessibility grant. Turn them on
# here if you want them.

# [modules]
# aerospace = true
# hammerspoon = true
# firefox = false
# containers = false
